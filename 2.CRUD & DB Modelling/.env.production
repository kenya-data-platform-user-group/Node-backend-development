# Application
# NODE_ENV is the selector — set it via the shell, package.json scripts, or docker-compose.
PORT=8000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=employee_db_production
DB_PORT_HOST=5432

# Drizzle / connection string (used inside the container, host = postgres service name)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/employee_db_production
