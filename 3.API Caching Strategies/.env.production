# Application
PORT=8000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=event_cache_db_production
DB_PORT_HOST=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/event_cache_db_production

# Redis / cache
REDIS_PORT_HOST=6379
REDIS_URL=redis://redis:6379
CACHE_TTL_MS=60000
CACHE_DETAIL_TTL_MS=120000
CACHE_VERSION_TTL_MS=86400000
