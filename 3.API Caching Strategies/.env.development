# Application
PORT=8000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=event_cache_db_development
DB_PORT_HOST=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/event_cache_db_development

# Redis / cache
REDIS_PORT_HOST=6379
REDIS_URL=redis://redis:6379
# REDIS_URL_PROD=redis://<username>:<password>@<host>:<port>/<db_number>

CACHE_TTL_MS=60000 # 1 minute for list endpoints, since they are read-heavy and can tolerate some staleness
CACHE_DETAIL_TTL_MS=120000 # 2 minutes for individual items, since they can be updated more frequently than the list
CACHE_VERSION_TTL_MS=86400000 # 24 hours, since list version changes only on writes

# 1 second = 1000 milliseconds, 1 minute = 60000 milliseconds, 1 hour = 3600000 milliseconds, 1 day = 86400000 milliseconds