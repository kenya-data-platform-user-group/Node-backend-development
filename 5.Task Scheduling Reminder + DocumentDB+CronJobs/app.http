### Create recurring reminder with end date
POST {{baseUrl}}/reminders
Content-Type: {{contentType}}

{
  "title": "Project daily sync",
  "message": "Daily check-in during project phase",
  "dueDate": "2026-01-20 10:00 AM",
  "timezone": "America/New_York",
  "isRecurring": true,
  "recurrencePattern": "daily",
  "recurrenceEndDate": "2026-03-31"
}

### Create one-time reminder with specific timezone
POST {{baseUrl}}/reminders
Content-Type: {{contentType}}

{
  "title": "International conference call",
  "message": "Call with Tokyo office",
  "dueDate": "2026-02-15 10:00 AM",
  "timezone": "Asia/Tokyo"
}

### Get all active recurring reminders
GET {{baseUrl}}/reminders/status/active

### Update reminder to enable recurrence
PATCH {{baseUrl}}/reminders/{{reminderId}}
Content-Type: {{contentType}}

{
  "isRecurring": true,
  "recurrencePattern": "weekly",
  "timezone": "America/New_York"
}

### Update reminder timezone only
PATCH {{baseUrl}}/reminders/{{reminderId}}
Content-Type: {{contentType}}

{
  "timezone": "Europe/London"
}

### Update recurrence pattern
PATCH {{baseUrl}}/reminders/{{reminderId}}
Content-Type: {{contentType}}

{
  "recurrencePattern": "monthly",
  "recurrenceInterval": 1
}

###############################################
# Testing Recurring Reminder Processing
###############################################

### Step 1: Create a recurring reminder with past due date (for immediate processing)
POST {{baseUrl}}/reminders
Content-Type: {{contentType}}

{
  "title": "Test Recurring Processing",
  "message": "This should be processed immediately and next occurrence calculated",
  "dueDate": "2025-01-01 10:00 AM",
  "timezone": "America/New_York",
  "isRecurring": true,
  "recurrencePattern": "daily"
}

### Step 2: Check active reminders (should see the reminder with nextDueDate updated)
GET {{baseUrl}}/reminders/status/active

### Step 3: Verify recurring reminder was processed and nextDueDate set
# Copy the ID from Step 1 response
GET {{baseUrl}}/reminders/{{reminderId}}
