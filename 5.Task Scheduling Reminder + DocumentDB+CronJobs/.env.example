# Application Configuration
# Port for the API server
PORT=3000

# Environment (development | production)
NODE_ENV=development

# Database Configuration
# MongoDB/DocumentDB connection string
# For local development with Docker: mongodb://admin:password@localhost:10260?authSource=admin&tls=true&tlsAllowInvalidCertificates=true&directConnection=true
# For local development without Docker: mongodb://localhost:27017
DATABASE_URL=mongodb://localhost:27017

# Database name
DATABASE_NAME=reminders
